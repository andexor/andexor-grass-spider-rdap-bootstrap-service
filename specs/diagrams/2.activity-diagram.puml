title Andexor Grass Spider (AGS)\nGet Domain Registration Data\nActivity Diagram

' Colors defined by Andexor Network Design System

!$ANDEXOR_BLUE_50  = "#F3F7FC"
!$ANDEXOR_BLUE_100 = "#E7EFF8"
!$ANDEXOR_BLUE_200 = "#C5D8EF"
!$ANDEXOR_BLUE_300 = "#8FB6E2"
!$ANDEXOR_BLUE_400 = "#4A8BD0"
!$ANDEXOR_BLUE_500 = "#1A5FA8"

!$OLD_GOLD_300 = "#F8D066"
!$OLD_GOLD_500 = "#EAAA00"

!$RETURN_OK  = %darken("#D7F0E3", 30)
!$RETURN_ERROR = %darken("#FBE1DE", 30)

<style>

root {
    BackgroundColor $ANDEXOR_BLUE_200
    HorizontalAlignment center
    LineColor $ANDEXOR_BLUE_400
    LineThickness 4
    Margin 20
    RoundCorner 20
    Shadowing 1
}

title {
    BackgroundColor $ANDEXOR_BLUE_500
    FontColor $ANDEXOR_BLUE_50
    Margin 20
    Padding 20
}

arrow {
    FontColor $ANDEXOR_BLUE_500
    FontStyle bold
}

activityDiagram {

    LineColor $ANDEXOR_BLUE_500

    diamond {
        BackgroundColor $OLD_GOLD_500
        LineColor $OLD_GOLD_300
    }

}

</style>

start

$ANDEXOR_BLUE_400:Find RDAP
Authoritative
Server;
if (URL?) then (yes)
    $ANDEXOR_BLUE_400:Get Domain
    Registration Data;
    if (Data?) then (yes)
        $RETURN_OK:Return Data;
        stop
    else (no)
        $RETURN_ERROR:Return Error;
        stop
    endif
else (no)
    $RETURN_ERROR:Return Error;
    stop
endif

@enduml
